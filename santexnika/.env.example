# Порт и адрес прослушивания
PORT=3000
HOST=0.0.0.0

# Администратор / вход в /admin. Задайте длинный уникальный пароль перед публикацией.
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Контакты магазина (значения уже взяты из публичной страницы сообщества)
STORE_NAME=Дом Сантехники
STORE_CITY=Балаково
STORE_PHONE=+7 (960) 359-37-39
STORE_EMAIL=dom-santehniki@mail.ru
STORE_ADDRESS_1=Трнавская ул., 73/1
STORE_ADDRESS_2=Степная ул., 52
STORE_HOURS_WEEKDAYS=Пн–Пт: 09:00–19:00
STORE_HOURS_WEEKENDS=Сб–Вс: 09:00–17:00
VK_PUBLIC_URL=https://vk.ru/houseplumbers
WHATSAPP_PUBLIC_URL=https://wa.me/79603593739
# Добавьте публичные чаты, если они есть; пустое значение скрывает кнопку.
TELEGRAM_PUBLIC_URL=
MAX_PUBLIC_URL=

# ВКонтакте: токен хранится только на сервере. ID сообщества по открытой витрине — 223639597.
# Для wall.get нужен токен сообщества/пользователя с правом чтения стены.
VK_ACCESS_TOKEN=
VK_GROUP_ID=223639597
VK_GROUP_SCREEN_NAME=houseplumbers
VK_API_VERSION=5.199
VK_SYNC_INTERVAL_MINUTES=30
VK_SYNC_COUNT=50
# Синхронизируются публикации, в которых есть хотя бы один ключ из списка.
VK_INCLUDE_KEYWORDS=сантех,смесител,ванн,душ,раковин,унитаз,мебел,акци,скидк,доставк,поступлен,инсталляц,керамогранит,труб,отоплен,комплект,кран,зеркал,полотенцесушител,grohe,gappo,azario,abber,viant,briz
VK_EXCLUDE_KEYWORDS=розыгрыш победител,поздравляем победител,вакансия

# Telegram Bot API: бот-токен + chat_id менеджера/рабочего чата.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MAX Bot API: токен бота и chat_id, который доступен этому боту.
# Запросы выполняются на platform-api2.max.ru с токеном в Authorization.
MAX_BOT_TOKEN=
MAX_CHAT_ID=
